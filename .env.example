# Copy this file to .env (git-ignored) and fill in what you need.
# All values are optional — with none set, the app renders bundled mock data.

# Dev/preview server port. Injected by Replit in production; defaults to 5173 locally.
PORT=5173

# App base path. Injected by Replit in production; defaults to "/" locally.
BASE_PATH=/

# Sanity project ID. Leave empty to use mock data instead of the CMS.
VITE_SANITY_PROJECT_ID=

# Sanity dataset name.
VITE_SANITY_DATASET=production
